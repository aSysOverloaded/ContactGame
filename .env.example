# Copy to .env and fill in. Nothing here costs money on the free providers.

# openrouter | gemini | anthropic | fake   (use fake while building UI - it spends no quota)
LLM_PROVIDER=openrouter

# https://openrouter.ai/keys - no card needed. Free = 50 requests/day, 20/min.
# Pick any model ending in :free from https://openrouter.ai/models?q=free (they rotate).
# Comma-separate several to fall back automatically when one is rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# https://aistudio.google.com/apikey - free tier, ~1,500 requests/day on Flash models.
# Leave billing OFF on the Google project or the free tier disappears.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: one-time $5 trial credit on a new Anthropic Console account (expires in 14 days).
# claude-sonnet-4-6 is what the original contact.html used. claude-haiku-4-5 ($1/$5 per M tokens)
# stretches the credit furthest; claude-opus-5 ($5/$25) plays best.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Seconds the STAND BY -> MARK countdown lasts.
COUNTDOWN_SECONDS=2.4
